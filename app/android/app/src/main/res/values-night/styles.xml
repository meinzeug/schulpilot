<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Opaque window/decor colors before Flutter's first frame, in both OS modes. -->
    <style name="SchulpilotWindowTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/schulpilot_splash_background</item>
        <item name="android:statusBarColor">@color/schulpilot_splash_background</item>
        <item name="android:navigationBarColor">@color/schulpilot_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <!-- Flutter removes the legacy launch surface when it draws its first frame. -->
    <style name="LaunchTheme" parent="@style/SchulpilotWindowTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Flutter's manifest metadata selects this without an intermediate OS-colored window. -->
    <style name="NormalTheme" parent="@style/SchulpilotWindowTheme" />
</resources>
