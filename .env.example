ENVIRONMENT=development
PUBLIC_URL=http://localhost:8080
DATABASE_URL=sqlite:///./data/schulpilot.sqlite
DATA_DIR=./data
WEB_DIR=./app/build/web
# Generate locally: .venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MASTER_KEY=
SYNTHETIC_DEMO=true
SYNTHETIC_AI_ENABLED=false
SYNTHETIC_AI_DAILY_LIMIT=40
REAL_DATA_APPROVED=false
PRIVACY_EVIDENCE=
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_SUPPORT_EMAIL=
OPERATIONS_ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CODEX_APPROVED=false
CODEX_SOCKET=
CODEX_AUTH_MODE=api_key
PUSH_APPROVED=false
PUSH_PRIVACY_EVIDENCE=
FCM_SERVICE_ACCOUNT_FILE=
# Public Firebase app identifiers only, never a service-account JSON/key:
FCM_PUBLIC_CONFIG=

# Optionaler Google-Elternzugang, eigenes Backend / kein Firebase Auth
GOOGLE_LOGIN_ENABLED=false
GOOGLE_OAUTH_CLIENT_FILE=
