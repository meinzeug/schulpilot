[Unit]
Description=SCHULPILOT isolated authenticated backup restore rehearsal
After=postgresql.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/opt/schulpilot/current/venv/bin/python /opt/schulpilot/current/deploy/restore_check.py
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/schulpilot-monitor
TimeoutStartSec=10min
