schulpilot.dorfspy.de {
  tls {
    issuer acme {
      dir https://acme-v02.api.letsencrypt.org/directory
    }
  }
  encode zstd gzip
  request_body {
    max_size 12MB
  }
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(self), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.gstatic.com/firebasejs/; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' blob: https://firebaseinstallations.googleapis.com https://fcmregistrations.googleapis.com https://fcm.googleapis.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    Cache-Control "no-cache"
  }
  @api path /api /api/*
  handle /push/firebase-messaging-sw.js {
    rewrite * /api/notifications/service-worker.js
    reverse_proxy 127.0.0.1:3240
  }
  handle /firebase-messaging-sw.js {
    rewrite * /api/notifications/service-worker.js
    reverse_proxy 127.0.0.1:3240
  }
  handle @api {
    reverse_proxy 127.0.0.1:3240 {
      header_up X-Forwarded-For {remote_host}
    }
  }
  handle_path /downloads/* {
    root * /opt/schulpilot/current/downloads
    header Content-Disposition "attachment"
    header Cache-Control "public, max-age=3600"
    file_server
  }
  handle {
    root * /opt/schulpilot/current/web
    try_files {path} /index.html
    file_server
  }
}
