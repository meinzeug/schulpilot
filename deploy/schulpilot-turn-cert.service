[Unit]
Description=Refresh isolated SCHULPILOT TURN certificate
After=caddy.service
ConditionPathExists=/etc/schulpilot-turn/turnserver.conf

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /etc/schulpilot-turn/refresh_certificate.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
