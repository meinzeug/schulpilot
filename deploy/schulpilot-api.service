[Unit]
Description=SCHULPILOT private learning API
After=network.target postgresql.service

[Service]
User=schulpilot
Group=schulpilot
WorkingDirectory=/opt/schulpilot/current/backend
EnvironmentFile=/etc/schulpilot/environment
ExecStart=/opt/schulpilot/current/venv/bin/python -m uvicorn schulpilot.main:app --host 127.0.0.1 --port 3240 --workers 1 --no-access-log --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=35
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/schulpilot
InaccessiblePaths=-/opt/merchagent -/opt/ai-artist-studio -/opt/artist-cli -/opt/buddys-art
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=350M
TasksMax=64

[Install]
WantedBy=multi-user.target
