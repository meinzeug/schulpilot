[Unit]
Description=SCHULPILOT content-free operational watchdog
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/schulpilot/current/deploy/monitor.py
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/schulpilot-monitor
TimeoutStartSec=90
